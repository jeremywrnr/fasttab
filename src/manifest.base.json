{
  "manifest_version": 3,
  "name": "fasttab",
  "version": "0.1.0",
  "description": "Fast fuzzy tab switcher for many tabs and tab groups. fzf scoring, frecency, instant popup.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "fasttab",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "open-switcher": {
      "suggested_key": { "default": "Alt+K", "mac": "MacCtrl+K" },
      "description": "Open fasttab"
    }
  },
  "options_ui": { "page": "welcome.html", "open_in_tab": true },
  "permissions": ["tabs", "tabGroups", "storage", "sessions", "bookmarks", "history", "activeTab", "scripting"],
  "web_accessible_resources": [{ "resources": ["popup.html"], "matches": ["<all_urls>"] }]
}
